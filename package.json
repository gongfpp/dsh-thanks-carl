{
  "name": "dsh-thanks-carl",
  "version": "0.3.0",
  "icon": "./icon.svg",
  "description": "Local Carl companion for DSH: pat reactions, focus timer, quick menu, edge wandering and reminders",
  "type": "module",
  "license": "MIT",
  "author": "gongfpp",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "easter-egg",
    "carl",
    "reminder"
  ],
  "homepage": "https://github.com/gongfpp/dsh-thanks-carl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gongfpp/dsh-thanks-carl.git"
  },
  "bugs": {
    "url": "https://github.com/gongfpp/dsh-thanks-carl/issues"
  },
  "engines": {
    "dsh": ">=0.2.1-0 <0.3.0-0",
    "node": ">=22.12"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/technical-decisions.md",
    "docs/verification.md",
    "docs/screenshots/",
    "scripts/install.ps1",
    "scripts/uninstall.ps1"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-thanks-carl",
    "summary": "摸摸会回应的卡尔，陪你专注 25/45 分钟；快捷菜单、可选边缘闲逛、完成彩蛋和本地提醒，不读对话、不调用模型。",
    "categories": [
      "fun"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {},
    "compatibility": {
      "dsh": ">=0.2.1-0 <0.3.0-0",
      "node": ">=22.12"
    },
    "permissions": {}
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build && npm test && node scripts/check-package.mjs",
    "verify": "node scripts/verify-browser.mjs",
    "prepare:personal": "node scripts/prepare-personal-assets.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.56.1",
    "sharp": "0.34.5"
  }
}
